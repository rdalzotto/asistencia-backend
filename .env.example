# ══════════════════════════════════════════════════════════════
# AsistenciaAR — Variables de entorno
# Copiar como .env y completar los valores reales
# ══════════════════════════════════════════════════════════════

# ─── Base de datos (Supabase) ──────────────────────────────────
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_cadena_muy_larga_y_aleatoria_minimo_64_caracteres

# ─── Web Push (VAPID) ─────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@tu-empresa.com

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=https://roaring-dolphin-29bc4e.netlify.app

# ─── Datos iniciales del empleador (para seed) ────────────────
RAZON_SOCIAL=EXIT SRL
NOMBRE_FANTASIA=EXIT
CUIT=30-00000000-0
DOMICILIO=Dirección de la empresa
LOCALIDAD=Concordia
PROVINCIA=Entre Ríos

# ─── Admin inicial ────────────────────────────────────────────
ADMIN_EMAIL=ingrogeliodalzotto@gmail.com
ADMIN_PASSWORD=CambiarEstaPassword123!

# ─── Configuración operativa ──────────────────────────────────
# Puerto del servidor
PORT=3000

# Hora de cierre automático de jornada (formato 24hs, Argentina)
HORA_CIERRE_AUTO=20

# Entorno
NODE_ENV=production

# ─── API de integración para el CRM (Mi empresa) ─────────────
# Token que el CRM manda como "Authorization: Bearer ...". Mínimo 32
# caracteres; generarlo al azar (p. ej. con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# y cargar el MISMO valor en ASISTENCIA_API_TOKEN del CRM. Sin estas dos
# variables, /api/integracion/v1 responde 503 (apagada).
INTEGRACION_CRM_TOKEN=
# id de la fila de EXIT S.A. en la tabla empleadores.
INTEGRACION_CRM_EMPLEADOR_ID=

# ─── Email de informes y constancias (26/10/2026) ────────────
# Todo sale desde avisos@ con el nombre del técnico y "responder a" su
# casilla. Servidor fijo: mail.exitsa.com.ar:465. La clave se carga solo en
# Railway. Sin estas dos, sigue saliendo desde la casilla de cada técnico
# (SMTP_USER_/SMTP_PASS_ ROGELIO, WALTER, ROBERTO, ANDREA), que se borran
# una vez probado avisos@.
SMTP_USER_AVISOS=avisos@exitsa.com.ar
SMTP_PASS_AVISOS=
